<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('layouts/meta'); %>
</head>

<body>
    <div class="app-container app-theme-white body-tabs-shadow fixed-header fixed-sidebar">
        <%- include('layouts/header'); %>
            <div class="app-main">
                <%- include('layouts/sidebar'); %>
                    <div class="app-main__outer">
                        <div class="app-main__inner">
                            <div class="app-page-title">
                                <div class="page-title-wrapper">
                                    <div class="page-title-heading">
                                        <div><%- title %></div>
                                    </div>
                                    <div class="page-title-actions">
                                    </div>
                                </div>
                            </div>
                            <div class="main-card mb-3 card">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-2"></div>
                                        <div class="col-md-8">
                                            <%- include('layouts/flash'); %>
                                                <form action="/areas_covered_post" method="post">
                                                    <div class="form-group">
                                                        <label class="label" for="areas_covered_title">Section
                                                            Title</label>
                                                        <input type="text" class="form-control" id="areas_covered_title"
                                                            name="areas_covered_title"
                                                            value="<%- data.areas_covered_title || '' %>" />
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="label" for="areas_covered_description">Section
                                                            Description</label>
                                                        <textarea class="form-control joeditor"
                                                            id="areas_covered_description"
                                                            name="areas_covered_description"
                                                            rows="5"><%- data.areas_covered_description || '' %></textarea>
                                                    </div>

                                                    <h4 class="mt-4 mb-3">Coverage Area Cards</h4>

                                                    <div id="cards-container">
                                                        <% let cards=[]; try { cards=JSON.parse(data.areas_covered_cards
                                                            || '[]' ); } catch (e) { cards=[]; }
                                                            cards.forEach(function(card, idx) { %>
                                                            <div class="card mb-3 card-item" data-index="<%= idx %>">
                                                                <div
                                                                    class="card-header d-flex justify-content-between align-items-center">
                                                                    <span>Card: <%= card.title %></span>
                                                                    <button type="button"
                                                                        class="btn btn-danger btn-sm remove-card-btn">Remove
                                                                        Card</button>
                                                                </div>
                                                                <div class="card-body">
                                                                    <input type="hidden" name="card_index[]"
                                                                        value="<%= idx %>">

                                                                    <div class="form-group">
                                                                        <label class="label">Area Group Title (e.g.
                                                                            Marina and Beachfront)</label>
                                                                        <input type="text" class="form-control"
                                                                            name="card_title[]"
                                                                            value="<%= card.title %>" required>
                                                                    </div>

                                                                    <div class="form-group">
                                                                        <label class="label">Sub-Areas (e.g. JBR, Palm
                                                                            Jumeirah, Umm Suqeim)</label>
                                                                        <textarea class="form-control joeditor"
                                                                            name="card_description[]" rows="3"
                                                                            required><%= card.description %></textarea>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                    </div>

                                                    <div class="form-group mb-4">
                                                        <button type="button" class="btn btn-success"
                                                            id="add-card-btn"><i class="fa fa-plus"></i> Add
                                                            Card</button>
                                                    </div>

                                                    <div class="form-group">
                                                        <button type="submit" class="btn btn-primary btn-lg">Update
                                                            Section</button>
                                                    </div>
                                                </form>
                                        </div>
                                        <div class="col-md-2"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <%- include('layouts/footer'); %>
                    </div>
            </div>
    </div>
    <div class="app-drawer-overlay d-none animated fadeIn"></div>
    <%- include('layouts/script'); %>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                let container = document.getElementById("cards-container");
                let addBtn = document.getElementById("add-card-btn");

                // Find next unique index
                let nextIndex = 0;
                document.querySelectorAll(".card-item").forEach(item => {
                    let idx = parseInt(item.getAttribute("data-index"));
                    if (idx >= nextIndex) {
                        nextIndex = idx + 1;
                    }
                });

                // Remove card delegation
                container.addEventListener("click", function (e) {
                    if (e.target.classList.contains("remove-card-btn")) {
                        if (confirm("Are you sure you want to remove this card?")) {
                            let cardItem = e.target.closest(".card-item");
                            if (cardItem) {
                                cardItem.remove();
                            }
                        }
                    }
                });

                // Add card logic
                addBtn.addEventListener("click", function () {
                    let cardHtml = `
            <div class="card mb-3 card-item" data-index="${nextIndex}">
                <div class="card-header d-flex justify-content-between align-items-center bg-light">
                    <span>New Card</span>
                    <button type="button" class="btn btn-danger btn-sm remove-card-btn">Remove Card</button>
                </div>
                <div class="card-body">
                    <input type="hidden" name="card_index[]" value="${nextIndex}">
                    
                    <div class="form-group">
                        <label class="label">Area Group Title</label>
                        <input type="text" class="form-control" name="card_title[]" placeholder="Enter area group title" required>
                    </div>
                    
                    <div class="form-group">
                        <label class="label">Sub-Areas</label>
                        <textarea class="form-control joeditor" name="card_description[]" rows="3" placeholder="Enter sub-areas" required></textarea>
                    </div>
                </div>
            </div>
        `;

                    container.insertAdjacentHTML('beforeend', cardHtml);
                    nextIndex++;
                });
            });
        </script>
</body>

</html>