<!DOCTYPE html>
<html lang="en">
<head>
	<%- include('layouts/meta'); %>
</head>
<body>
<div class="app-container app-theme-white body-tabs-shadow fixed-header fixed-sidebar">
	<%- include('layouts/header'); %>
	<div class="app-main">
		<%- include('layouts/sidebar'); %>
		<div class="app-main__outer">
			<div class="app-main__inner">
				<div class="app-page-title">
					<div class="page-title-wrapper">
						<div class="page-title-heading">
							<div><%- title %></div>
						</div>
						<div class="page-title-actions">
						</div>
					</div>
				</div>
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-2"></div>
                            <div class="col-md-8">
                                <%- include('layouts/flash'); %>
                                <form action="/get_started_post" method="post" enctype="multipart/form-data">
                                    <div class="form-group">
                                        <label class="label" for="get_started_title">Section Title</label>
                                        <input type="text" class="form-control" id="get_started_title" name="get_started_title" value="<%- data.get_started_title || '' %>" required/>
                                    </div>

                                    <div class="form-group">
                                        <label class="label" for="get_started_description">Section Description (Para 1 & 2)</label>
                                        <textarea class="form-control joeditor" id="get_started_description" name="get_started_description" rows="5"><%- data.get_started_description || '' %></textarea>
                                    </div>

                                    <div class="form-group">
                                        <label class="label" for="get_started_image">Left-Side Main Image</label>
                                        <input type="file" class="form-control" id="get_started_image" name="get_started_image">
                                        <% if(data.get_started_image) { %>
                                            <br><a href="<%= siteUrl %>/uploads/homepagecontents/<%= data.get_started_image %>" target="_blank">
                                                <img class="img-thumbnail" style="max-height: 150px;" src="<%= siteUrl %>/uploads/homepagecontents/<%= data.get_started_image %>"/>
                                            </a>
                                            <input type="hidden" name="get_started_image_old" value="<%= data.get_started_image %>">
                                        <% } %>
                                    </div>

                                    <div class="form-group mt-4">
                                        <button type="submit" class="btn btn-primary btn-lg">Update Section</button>
                                    </div>
                                </form>
                            </div>
                            <div class="col-md-2"></div>
                        </div>
                    </div>
                </div>
			</div>
			<%- include('layouts/footer'); %>
		</div>
	</div>
</div>
<div class="app-drawer-overlay d-none animated fadeIn"></div>
<%- include('layouts/script'); %>
</body>
</html>
