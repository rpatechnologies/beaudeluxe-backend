<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('layouts/meta'); %>
</head>

<body>
    <div class="app-container app-theme-white body-tabs-shadow fixed-header fixed-sidebar">
        <%- include('layouts/header'); %>
            <div class="app-main">
                <%- include('layouts/sidebar'); %>
                    <div class="app-main__outer">
                        <div class="app-main__inner">
                            <div class="app-page-title">
                                <div class="page-title-wrapper">
                                    <div class="page-title-heading">
                                        <div><%- title %></div>
                                    </div>
                                </div>
                            </div>
                            <div class="main-card mb-3 card">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-2"></div>
                                        <div class="col-md-8">
                                            <%- include('layouts/flash'); %>
                                                <form action="/therapist_founder_post" method="post"
                                                    enctype="multipart/form-data">
                                                    <div class="form-group">
                                                        <label class="label" for="therapist_founder_title">Section Main
                                                            Title *</label>
                                                        <input type="text" class="form-control"
                                                            id="therapist_founder_title" name="therapist_founder_title"
                                                            value="<%- data.therapist_founder_title || 'A Note from Our Founder' %>"
                                                            required />
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="label" for="therapist_founder_image">Founder
                                                            Photo</label>
                                                        <input type="file" class="form-control-file"
                                                            id="therapist_founder_image"
                                                            name="therapist_founder_image" />
                                                        <input type="hidden" name="therapist_founder_image_old"
                                                            value="<%- data.therapist_founder_image || '' %>" />
                                                        <% if (data.therapist_founder_image) { %>
                                                            <br><img
                                                                src="<%- siteUrl + '/uploads/homepagecontents/' + data.therapist_founder_image %>"
                                                                style="max-height: 120px; border-radius: 10px;" />
                                                            <% } %>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="label" for="therapist_founder_quote">Founder Quote
                                                            / Message *</label>
                                                        <textarea class="form-control joeditor"
                                                            id="therapist_founder_quote" name="therapist_founder_quote"
                                                            rows="4"
                                                            required><%- data.therapist_founder_quote || 'I founded BeauDeluxe because Dubai deserved home massage service that felt as reliable as a good hotel spa. I do not practice myself. My job is to find the best therapists in this city, treat them well, and keep the quality bar high. Every person on this page is someone I would trust with my own family.' %></textarea>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="label" for="therapist_founder_name">Founder Name
                                                            *</label>
                                                        <input type="text" class="form-control"
                                                            id="therapist_founder_name" name="therapist_founder_name"
                                                            value="<%- data.therapist_founder_name || 'El Hassan Elfadli' %>"
                                                            required />
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="label" for="therapist_founder_role">Founder Role /
                                                            Title *</label>
                                                        <input type="text" class="form-control"
                                                            id="therapist_founder_role" name="therapist_founder_role"
                                                            value="<%- data.therapist_founder_role || 'Founder, BeauDeluxe.' %>"
                                                            required />
                                                    </div>

                                                    <div class="form-group mt-3">
                                                        <button type="submit" class="btn btn-primary">Save
                                                            Changes</button>
                                                    </div>
                                                </form>
                                        </div>
                                        <div class="col-md-2"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <%- include('layouts/footer'); %>
                    </div>
            </div>
    </div>
    <%- include('layouts/script'); %>
</body>

</html>