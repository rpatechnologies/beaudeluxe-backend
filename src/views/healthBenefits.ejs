<!DOCTYPE html>
<html lang="en">
<head>
	<%- include('layouts/meta'); %>
</head>
<body>
<div class="app-container app-theme-white body-tabs-shadow fixed-header fixed-sidebar">
	<%- include('layouts/header'); %>
	<div class="app-main">
		<%- include('layouts/sidebar'); %>
		<div class="app-main__outer">
			<div class="app-main__inner">
				<div class="app-page-title">
					<div class="page-title-wrapper">
						<div class="page-title-heading">
							<div><%- title %></div>
						</div>
						<div class="page-title-actions">
						</div>
					</div>
				</div>
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-2"></div>
                            <div class="col-md-8">
                                <%- include('layouts/flash'); %>
                                <form action="/health_benefits_post" method="post" enctype="multipart/form-data">
                                    <div class="form-group">
                                        <label class="label" for="health_benefits_title">Section Title</label>
                                        <input type="text" class="form-control" id="health_benefits_title" name="health_benefits_title" value="<%- data.health_benefits_title || '' %>"/>
                                    </div>

                                    <div class="form-group">
                                        <label class="label" for="health_benefits_description">Section Description</label>
                                        <textarea class="form-control joeditor" id="health_benefits_description" name="health_benefits_description" rows="5"><%- data.health_benefits_description || '' %></textarea>
                                    </div>

                                    <h4 class="mt-4 mb-3">Health Benefit Cards</h4>
                                    
                                    <div id="cards-container">
                                        <% 
                                            let cards = [];
                                            try {
                                                cards = JSON.parse(data.health_benefits_cards || '[]');
                                            } catch (e) {
                                                cards = [];
                                            }
                                            cards.forEach(function(card, idx) { 
                                        %>
                                            <div class="card mb-3 card-item" data-index="<%= idx %>">
                                                <div class="card-header d-flex justify-content-between align-items-center">
                                                    <span>Card: <%= card.title %></span>
                                                    <button type="button" class="btn btn-danger btn-sm remove-card-btn">Remove Card</button>
                                                </div>
                                                <div class="card-body">
                                                    <input type="hidden" name="card_index[]" value="<%= idx %>">
                                                    <input type="hidden" name="card_image_old[]" value="<%= card.image %>">
                                                    
                                                    <div class="form-group">
                                                        <label class="label">Number Prefix (e.g. 1, 2, 3)</label>
                                                        <input type="text" class="form-control" name="card_number[]" value="<%= card.number || '' %>" required>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="label">Title</label>
                                                        <input type="text" class="form-control" name="card_title[]" value="<%= card.title %>" required>
                                                    </div>
                                                    
                                                    <div class="form-group">
                                                        <label class="label">Image</label>
                                                        <input type="file" class="form-control" name="card_image_<%= idx %>">
                                                        <% if(card.image) { %>
                                                            <br><a href="<%= siteUrl %>/uploads/homepagecontents/<%= card.image %>" target="_blank">
                                                                <img class="img-thumbnail" style="max-height: 100px;" src="<%= siteUrl %>/uploads/homepagecontents/<%= card.image %>"/>
                                                            </a>
                                                        <% } %>
                                                    </div>
                                                    
                                                    <div class="form-group">
                                                        <label class="label">Description</label>
                                                        <textarea class="form-control" name="card_description[]" rows="3" required><%= card.description %></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>

                                    <div class="form-group mb-4">
                                        <button type="button" class="btn btn-success" id="add-card-btn"><i class="fa fa-plus"></i> Add Card</button>
                                    </div>

                                    <div class="form-group">
                                        <button type="submit" class="btn btn-primary btn-lg">Update Section</button>
                                    </div>
                                </form>
                            </div>
                            <div class="col-md-2"></div>
                        </div>
                    </div>
                </div>
			</div>
			<%- include('layouts/footer'); %>
		</div>
	</div>
</div>
<div class="app-drawer-overlay d-none animated fadeIn"></div>
<%- include('layouts/script'); %>

<script>
document.addEventListener("DOMContentLoaded", function() {
    let container = document.getElementById("cards-container");
    let addBtn = document.getElementById("add-card-btn");
    
    // Find next unique index
    let nextIndex = 0;
    document.querySelectorAll(".card-item").forEach(item => {
        let idx = parseInt(item.getAttribute("data-index"));
        if (idx >= nextIndex) {
            nextIndex = idx + 1;
        }
    });

    // Remove card delegation
    container.addEventListener("click", function(e) {
        if (e.target.classList.contains("remove-card-btn")) {
            if (confirm("Are you sure you want to remove this card?")) {
                let cardItem = e.target.closest(".card-item");
                if (cardItem) {
                    cardItem.remove();
                }
            }
        }
    });

    // Add card logic
    addBtn.addEventListener("click", function() {
        let cardHtml = `
            <div class="card mb-3 card-item" data-index="${nextIndex}">
                <div class="card-header d-flex justify-content-between align-items-center bg-light">
                    <span>New Card</span>
                    <button type="button" class="btn btn-danger btn-sm remove-card-btn">Remove Card</button>
                </div>
                <div class="card-body">
                    <input type="hidden" name="card_index[]" value="${nextIndex}">
                    <input type="hidden" name="card_image_old[]" value="">
                    
                    <div class="form-group">
                        <label class="label">Number Prefix (e.g. 1, 2, 3)</label>
                        <input type="text" class="form-control" name="card_number[]" placeholder="Enter number prefix" required>
                    </div>

                    <div class="form-group">
                        <label class="label">Title</label>
                        <input type="text" class="form-control" name="card_title[]" placeholder="Enter card title" required>
                    </div>
                    
                    <div class="form-group">
                        <label class="label">Image</label>
                        <input type="file" class="form-control" name="card_image_${nextIndex}" required>
                    </div>
                    
                    <div class="form-group">
                        <label class="label">Description</label>
                        <textarea class="form-control" name="card_description[]" rows="3" placeholder="Enter card description" required></textarea>
                    </div>
                </div>
            </div>
        `;
        
        container.insertAdjacentHTML('beforeend', cardHtml);
        nextIndex++;
    });
});
</script>
</body>
</html>
