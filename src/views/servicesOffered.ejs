<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('layouts/meta'); %>
</head>

<body>
    <div class="app-container app-theme-white body-tabs-shadow fixed-header fixed-sidebar">
        <%- include('layouts/header'); %>
            <div class="app-main">
                <%- include('layouts/sidebar'); %>
                    <div class="app-main__outer">
                        <div class="app-main__inner">
                            <div class="app-page-title">
                                <div class="page-title-wrapper">
                                    <div class="page-title-heading">
                                        <div><%- title %></div>
                                    </div>
                                    <div class="page-title-actions">
                                    </div>
                                </div>
                            </div>
                            <div class="main-card mb-3 card">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-2"></div>
                                        <div class="col-md-8">
                                            <%- include('layouts/flash'); %>
                                                <form action="/services_offered_post" method="post"
                                                    enctype="multipart/form-data">
                                                    <div class="form-group">
                                                        <label class="label" for="services_offered_title">Section
                                                            Title</label>
                                                        <input type="text" class="form-control"
                                                            id="services_offered_title" name="services_offered_title"
                                                            value="<%- data.services_offered_title || '' %>" />
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="label" for="services_offered_intro">Introductory
                                                            Paragraph</label>
                                                        <textarea class="form-control joeditor"
                                                            id="services_offered_intro" name="services_offered_intro"
                                                            rows="3"><%- data.services_offered_intro || '' %></textarea>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="label" for="services_offered_main_image">Image</label>
                                                        <input type="file" class="form-control"
                                                            id="services_offered_main_image" name="services_offered_main_image" />
                                                        <input type="hidden" id="services_offered_main_image_old"
                                                            name="services_offered_main_image_old"
                                                            value="<%- data.services_offered_main_image || '' %>" />
                                                        <% if(data && data.services_offered_main_image) { %>
                                                            <br><a
                                                                href="<%- siteUrl +'/uploads/homepagecontents/'+ data.services_offered_main_image %>"
                                                                target="_blank">
                                                                <img class="img-thumbnail" style="max-height: 150px;"
                                                                    src="<%- siteUrl +'/uploads/homepagecontents/'+ data.services_offered_main_image %>" />
                                                            </a>
                                                            <% } %>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="label" for="services_offered_main_image_alt_tag">Image
                                                            Alt Tag</label>
                                                        <input type="text" class="form-control"
                                                            id="services_offered_main_image_alt_tag"
                                                            name="services_offered_main_image_alt_tag"
                                                            value="<%- data.services_offered_main_image_alt_tag || '' %>" />
                                                    </div>

                                                    <!-- Q&A 1 -->
                                                    <div class="card mb-3">
                                                        <div class="card-header">Residential Home Massage (Q&A 1)</div>
                                                        <div class="card-body">
                                                            <div class="form-group">
                                                                <label class="label" for="services_offered_qa1_title">Question
                                                                    Heading</label>
                                                                <input type="text" class="form-control"
                                                                    id="services_offered_qa1_title" name="services_offered_qa1_title"
                                                                    value="<%- data.services_offered_qa1_title || '' %>" />
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="label" for="services_offered_qa1_content">Answer
                                                                    Paragraph</label>
                                                                <textarea class="form-control joeditor"
                                                                    id="services_offered_qa1_content"
                                                                    name="services_offered_qa1_content"
                                                                    rows="3"><%- data.services_offered_qa1_content || '' %></textarea>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Q&A 2 -->
                                                    <div class="card mb-3">
                                                        <div class="card-header">Hotels and Offices (Q&A 2)</div>
                                                        <div class="card-body">
                                                            <div class="form-group">
                                                                <label class="label" for="services_offered_qa2_title">Question
                                                                    Heading</label>
                                                                <input type="text" class="form-control"
                                                                    id="services_offered_qa2_title" name="services_offered_qa2_title"
                                                                    value="<%- data.services_offered_qa2_title || '' %>" />
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="label" for="services_offered_qa2_content">Answer
                                                                    Paragraph</label>
                                                                <textarea class="form-control joeditor"
                                                                    id="services_offered_qa2_content"
                                                                    name="services_offered_qa2_content"
                                                                    rows="3"><%- data.services_offered_qa2_content || '' %></textarea>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <button type="submit" class="btn btn-primary">Update</button>
                                                    </div>
                                                </form>
                                        </div>
                                        <div class="col-md-2"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <%- include('layouts/footer'); %>
                    </div>
            </div>
    </div>
    <div class="app-drawer-overlay d-none animated fadeIn"></div>
    <%- include('layouts/script'); %>
</body>

</html>