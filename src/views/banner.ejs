<!DOCTYPE html>
<html lang="en">
<head>
	<%- include('layouts/meta'); %>
</head>
<body>
<div class="app-container app-theme-white body-tabs-shadow fixed-header fixed-sidebar">
	<%- include('layouts/header'); %>
	<div class="app-main">
		<%- include('layouts/sidebar'); %>
		<div class="app-main__outer">
			<div class="app-main__inner">
				<div class="app-page-title">
					<div class="page-title-wrapper">
						<div class="page-title-heading">
							<div><%- title %></div>
						</div>
						<div class="page-title-actions">
							<!-- <button type="button" data-toggle="tooltip" title="Example Tooltip" data-placement="bottom" class="btn-shadow mr-3 btn btn-dark">
								<i class="fa fa-star"></i>
							</button> -->
						</div>
					</div>
				</div>
                <% if(action=='add' || action=='edit') { %>
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-2"></div>
                            <div class="col-md-8">
                                <%- include('layouts/flash'); %>
                                <form action="/banner_post" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="id" value="<%- row ? row.id : '' %>">
                                    <div class="form-group">
                                        <label class="label" for="page_id">Page *</label>
                                        <select class="form-control" id="page_id" name="page_id" required>
                                            <option value="">Select</option>
                                            <% pages.forEach(function(page, index) { %>
                                            <option value="<%- page.id %>" <%- row && row.page_id == page.id ? 'selected' : '' %>><%- page.name %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="title">Title *</label>
                                        <input type="text" class="form-control" id="title" name="title" value="<%- row ? row.title : '' %>" required/>
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="image">Image *</label>
                                        <% if(row && row.image) { %>
                                        <input type="file" class="form-control" id="image" name="image" value="<%- row ? row.image : '' %>"/>
                                        <% } else{ %>
                                            <input type="file" class="form-control" id="image" name="image" value="<%- row ? row.image : '' %>" required/>
                                        <% } %>
                                        <input type="hidden" id="image_old" name="image_old" value="<%- row ? row.image : '' %>"/>
                                        <span class="help-block text-danger"><b>Recommend Size : 1923 X 870 PX.</b></span><br>
                                        <% if(row && row.image) { %>
                                        <a href="<%- siteUrl +'/uploads/banners/'+ row.image %>" target="_blank">
                                            <img class="img-thumbnail" src="<%- siteUrl +'/uploads/banners/'+ row.image %>"/>
                                        </a>
                                        <% } %>
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="altTagImage">Alt Tag Image</label>
                                        <input type="text" class="form-control" id="altTagImage" name="altTagImage" value="<%- row ? row.altTagImage : '' %>" required/>
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="image_mob">Mobile Image *</label>                                        
                                        <% if(row && row.image) { %>
                                        <input type="file" class="form-control" id="image_mob" name="image_mob" value="<%- row ? row.image_mob : '' %>"/>
                                        <% } else{ %>
                                            <input type="file" class="form-control" id="image_mob" name="image_mob" value="<%- row ? row.image_mob : '' %>" required/>
                                        <% } %>
                                        <input type="hidden" id="image_mob_old" name="image_mob_old" value="<%- row ? row.image_mob : '' %>"/>
                                        <span class="help-block text-danger"><b>Recommend Size : 360 X 412 PX.</b></span><br>
                                        <% if(row && row.image_mob) { %>
                                        <a href="<%- siteUrl +'/uploads/banners/'+ row.image_mob %>" target="_blank">
                                            <img class="img-thumbnail" src="<%- siteUrl +'/uploads/banners/'+ row.image_mob %>"/>
                                        </a>
                                        <% } %>
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="altTagImageMob">Alt Tag Mobile Image</label>
                                        <input type="text" class="form-control" id="altTagImageMob" name="altTagImageMob" value="<%- row ? row.altTagImageMob : '' %>" required/>
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="description">Description</label>
                                        <textarea  class="form-control" id="description" name="description"> <%- row?.description %> </textarea>
                                    </div>
                                    <!-- <div class="form-group">
                                        <label class="label" for="order_no">Order No *</label>
                                        <input type="number" class="form-control" id="order_no" name="order_no" min="0" value="<%- row ? row.order_no : '' %>"/>
                                    </div> -->
                                    <div class="form-group">
                                        <label class="label" for="status">Status *</label>
                                        <select class="form-control" id="status" name="status"required>
                                            <option value="1" <%- row && row.status == 1 ? 'selected' : '' %>>Active</option>
                                            <option value="0" <%- row && row.status == 0 ? 'selected' : '' %>>Inactive</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <a href="<%- siteUrl +'/'+ page %>" class="btn btn-secondary" style="color: white;">Cancel</a>
                                        <button type="submit" class="btn btn-primary">Submit</button>
                                    </div>
                                </form>
                            </div>
                            <div class="col-md-2"></div>
                        </div>
                    </div>
                </div>    
                <% } else if(action=='view') { %>
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <table class="mb-0 table table-bordered">
                            <tbody>
                                <tr>
                                    <th style="width: 15%">Page</th>
                                    <td><%- row.page?.name %></td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Title</th>
                                    <td><%- row.title %></td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Image</th>
                                    <td>
                                        <a href="<%- siteUrl +'/uploads/banners/'+ row.image %>" target="_blank">
                                            <img class="img-thumbnail" src="<%- siteUrl +'/uploads/banners/'+ row.image %>"/>
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Alt Tag Image</th>
                                    <td><%- row.altTagImage %></td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Mobile Image</th>
                                    <td>
                                        <a href="<%- siteUrl +'/uploads/banners/'+ row.image_mob %>" target="_blank">
                                            <img class="img-thumbnail" src="<%- siteUrl +'/uploads/banners/'+ row.image_mob %>"/>
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Alt Tag Mobile Image</th>
                                    <td><%- row.altTagImageMob %></td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Description</th>
                                    <td><%- row.description %></td>
                                </tr>
                                <!-- <tr>
                                    <th style="width: 15%">Order No</th>
                                    <td><%- row.order_no %></td>
                                </tr> -->
                                <tr>
                                    <th style="width: 15%">Created At</th>
                                    <td><%- new Date(row.createdAt).toLocaleString('en-GB', { hour12: false }) %></td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Status</th>
                                    <td>
                                        <% if(row.status == 1) { %>
                                            <div class="mb-2 mr-2 badge badge-success">Active</div>
                                        <% } else { %>
                                            <div class="mb-2 mr-2 badge badge-secondary">Inactive</div>
                                        <% } %>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <br>
                        <a href="<%- siteUrl+'/'+pageUrl %>" class="btn btn-secondary btn-icon" style="color: white;"><i class="pe-7s-back btn-icon-wrapper"> </i>Back</a>
                    </div>
                </div>
                <% } else { %>
                <div class="row">
                    <div class="col-md-12">
                        <%- include('layouts/flash'); %>
                        <% if(pages.length>0) { %>
                        <a href="<%- siteUrl +'/'+ page %>?action=add" class="mb-2 mr-2 btn-icon btn btn-primary pull-right"><i class="fa fa-plus"></i> Add New Record</a>
                        <% } %>
                    </div>
                </div>
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <table style="width: 100%;" id="example" class="table table-hover table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th width="5%">#</th>
                                    <th>Page</th>
                                    <th>Title</th>
                                    <!-- <th>Image</th> -->
                                    <!-- <th>Alt Tag Image</th> -->
                                    <!-- <th>Mobile Image</th> -->
                                    <!-- <th>Alt Tag Mobile Image</th> -->
                                    <th>Description</th>
                                    <!-- <th>Order No</th> -->
                                    <!-- <th width="10%">Updated At</th> -->
                                    <th width="5%">Status</th>
                                    <th width="15%" style="text-align: center;vertical-align: middle;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% rows.forEach(function(data, index) { %>
                                <tr>
                                    <td><%- index + 1 %></td>
                                    <td><%- data.page ? data.page.name : '' %></td>
                                    <td><%- data.title %></td>
                                    <!-- <td>
                                        <a href="<%- siteUrl +'/uploads/banners/'+ data.image %>" target="_blank">
                                            <img class="img-thumbnail" src="<%- siteUrl +'/uploads/banners/'+ data.image %>"/>
                                        </a>
                                    </td> -->
                                    <!-- <td><%- data.altTagImage %></td> -->
                                    <!-- <td>
                                        <a href="<%- siteUrl +'/uploads/banners/'+ data.image_mob %>" target="_blank">
                                            <img class="img-thumbnail" src="<%- siteUrl +'/uploads/banners/'+ data.image_mob %>"/>
                                        </a>
                                    </td> -->
                                    <!-- <td><%- data.altTagImageMob %></td> -->
                                    <td><%- data.description %></td>
                                    <!-- <td><%- data.order_no %></td>
                                    <td><%- new Date(data.updatedAt).toLocaleString('en-GB', { hour12: false }) %></td> -->
                                    <td>
                                        <% if(data.status == 1) { %>
                                            <div class="mb-2 mr-2 badge badge-success">Active</div>
                                        <% } else { %>
                                            <div class="mb-2 mr-2 badge badge-secondary">Inactive</div>
                                        <% } %>
                                    </td>
                                    <td style="text-align: center;vertical-align: middle;">
                                        <!-- <a href="<%- siteUrl+'/'+pageUrl+'?action=view&id='+data.id %>" class="btn btn-focus btn-xs" data-toggle="tooltip" data-placement="top" title="View" data-original-title="View"><i class="fa fa-eye"></i></a> -->
                                        <!-- <a href="<%- siteUrl+'/'+pageUrl+'?action=edit&id='+data.id %>" class="btn btn-primary btn-xs" data-toggle="tooltip" data-placement="top" title="Edit" data-original-title="Edit"><i class="fas fa-edit"></i></a> -->
                                        <!-- <a href="javascript:del('<%- siteUrl+'/'+pageUrl+'?action=delete&id='+data.id %>')" class="btn btn-danger btn-xs" data-toggle="tooltip" data-placement="top" title="Delete" data-original-title="Delete"><i class="fas fa-trash"></i></a> -->
                                        <a href="<%- siteUrl+'/'+pageUrl+'?action=view&id='+data.id %>" class="btn "  data-toggle="tooltip" data-placement="top" title="View" data-original-title="View"><span style=" color: rgb(0, 0, 0);"><i class="fa fa-eye" title="View"></i></span></a>
                                        <a href="<%- siteUrl+'/'+pageUrl+'?action=edit&id='+data.id %>" class="btn "  data-toggle="tooltip" data-placement="top" title="Edit" data-original-title="Edit"><span style=" color: rgb(32, 108, 221);"><i class="fa fa-pen" title="Edit"></i></span></a>
                                        <!-- <a href="javascript:del('<%- siteUrl+'/'+pageUrl+'?action=delete&id='+data.id %>')" class="btn" data-toggle="tooltip" data-placement="top" title="Delete" data-original-title="Delete"><span style=" color: red;"><i class="fa fa-trash" title="Delete"></i></span></a> -->
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>                        
                    </div>
                </div>
                <% } %>
			</div>
			<%- include('layouts/footer'); %>
		</div>
	</div>
</div>
<div class="app-drawer-overlay d-none animated fadeIn"></div>
<%- include('layouts/script'); %>
</body>
</html>
