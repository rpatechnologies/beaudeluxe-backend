<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= metaTitle %></title>
	<%- include('layouts/meta'); %>
</head>
<body>
<div class="app-container app-theme-white body-tabs-shadow fixed-header fixed-sidebar">
	<%- include('layouts/header'); %>
	<div class="app-main">
		<%- include('layouts/sidebar'); %>
		<div class="app-main__outer">
			<div class="app-main__inner">
				<div class="app-page-title">
					<div class="page-title-wrapper">
						<div class="page-title-heading">
							<div><%- title %></div>
						</div>
						<div class="page-title-actions">
						</div>
					</div>
				</div>
                <% if(action=='add' || action=='edit') { %>
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-2"></div>
                            <div class="col-md-8">
                                <%- include('layouts/flash'); %>
                                <form action="/sub_service_post" method="post">
                                    <input type="hidden" name="id" id="subservice_id" value="<%- row ? row.id : '' %>">
                                    <div class="form-group">
                                        <label class="label" for="page_id">Service *</label>
                                        <select class="form-control" id="service_id" name="service_id"required>
                                            <option value="">Select</option>
                                            <% service?.forEach(function(service, index) { %>
                                            <option value="<%- service.id %>" <%- row && row.service_id == service.id ? 'selected' : '' %>><%- service.title %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="category">Select Type *</label>
                                        <select class="form-control" id="category" name="category" >
                                            <option value="">Select</option>
                                            <option value="category" <%- row && row.type == 'category' ? 'selected' : '' %>>Category</option>
                                            <option value="gender" <%- row && row.type == 'gender' ? 'selected' : '' %>>Gender</option>
                                            <option value="duration" <%- row && row.type == 'duration' ? 'selected' : '' %>>Duration</option>
                                        </select>
                                    </div>
                                    <div id ="pricediv" class="mb-3 card" style="display: none;">
                                        <div class="card-header">
                                            Type & Price
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-bordered" id="durationTable">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 40%;">Duration</th>
                                                        <th style="width: 40%;">Price</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="showdata">
                                                </tbody>
                                                
                                            </table>
                                        </div>
                                    </div> 
                                    
                                    <div class="form-group">
                                        <label class="label" for="title">Title *</label>
                                        <input type="text" class="form-control" id="title" name="title" value="<%- row ? row.title : '' %>" />
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="description">Description*</label>
                                        <input type="text" class="form-control joeditor" id="description" name="description" value="<%= row ? row.description : '' %>" />
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="order_no">Order Number*</label>
                                        <input type="text" class="form-control" id="order_no" name="order_no" value="<%= row ? row.order_no : '' %>" />
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="status">Status </label>
                                        <select class="form-control" id="status" name="status">
                                            <option value="1" <%- row && row.status == 1 ? 'selected' : '' %>>Active</option>
                                            <option value="0" <%- row && row.status == 0 ? 'selected' : '' %>>Inactive</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <a href="<%- siteUrl +'/'+ page %>" class="btn btn-secondary" style="color: white;">Cancel</a>
                                        <button type="submit" class="btn btn-primary">Submit</button>
                                    </div>
                                </form>
                            </div>
                            <div class="col-md-2"></div>
                        </div>
                    </div>
                </div>    
                <% } else if(action=='view') { %>
                    <div class="main-card mb-3 card">
                        <div class="card-body">
                            <table class="mb-0 table table-bordered">
                                <tbody>
                                    <tr>
                                        <th style="width: 15%">Title</th>
                                        <td><%- row.title %></td>
                                    </tr>
                                    <tr>
                                        <th style="width: 15%">Service</th>
                                        <td><%- row.service?.title %></td>
                                    </tr>
                                    <tr>
                                        <th style="width: 15%">Order Number</th>
                                        <td><%- row.service?.order_no %></td>
                                    </tr>
                                    <tr>
                                        <th style="width: 15%">Service price</th>
                                        <td>
                                        <table>
                                            <tbody>
                                                <% if (subservice_price && subservice_price.length > 0) { %>
                                                    <tr>
                                                        <th>Category</th>
                                                        <th>Price</th>
                                                    </tr>
                                                    <% for(let element of subservice_price) { %>
                                                        <tr>
                                                            <td><%- element.title %></td>
                                                            <td><%- element.price %></td>
                                                        </tr>
                                                    <% } %>
                                                <% } else { %>
                                                    <tr>
                                                        <th style="width: 15%">Subservice Price</th>
                                                        <td>No data available</td>
                                                    </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </td>
                                    </tr>
                                    <tr>
                                        <th style="width: 15%">Description</th>
                                        <td><%- row.description %></td>
                                    </tr>
                                    <tr>
                                        <th style="width: 15%">Created At</th>
                                        <td><%- new Date(row.updatedAt).toLocaleString('en-GB', {dateStyle: "short", timeStyle: "short", hour12: true}) %></td>
                                    </tr>
                                    <tr>
                                        <th style="width: 15%">Status</th>
                                        <td>
                                            <% if(row.status == 1) { %>
                                                <div class="mb-2 mr-2 badge badge-success">Active</div>
                                            <% } else { %>
                                                <div class="mb-2 mr-2 badge badge-secondary">Inactive</div>
                                            <% } %>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <br>
                            <a href="<%- siteUrl+'/'+pageUrl %>" class="btn btn-secondary btn-icon" style="color: white;">
                                <i class="pe-7s-back btn-icon-wrapper"></i> Back
                            </a>
                        </div>
                    </div>
                <% } else { %>
                <div class="row">
                    <div class="col-md-12">
                        <%- include('layouts/flash'); %>
                        <a href="<%- siteUrl +'/'+ page %>?action=add" class="mb-2 mr-2 btn-icon btn btn-primary pull-right"><i class="fa fa-plus"></i> Add New Record</a>
                    </div>
                </div>
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <table style="width: 100%;" id="example" class="table table-hover table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th style = "width:5%">#</th>
                                    <th>Title</th>
                                    <th>Service</th>
                                    <th style = "width:10%">Created At</th>
                                    <th style = "width:5%">Status</th>
                                    <th style = "width:10%">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% rows.forEach(function(data, index) { %>
                                <tr>
                                    <td><%- index + 1 %></td>
                                    <td><%- data.title %></td>
                                    <td><%- data.service?.title%></td>
                                    <!-- <td>
                                        <a href="<%- siteUrl +'/uploads/sub_service/'+ data.image %>" target="_blank">
                                            <img class="img-thumbnail" src="<%- siteUrl +'/uploads/sub_service/'+ data.image %>" alt=""/>
                                        </a>
                                    </td> -->
                                    

                                    <td><%- new Date(data.updatedAt).toLocaleString('en-GB', {dateStyle: "short", timeStyle: "short", hour12: true}) %></td>
                                    <td>
                                        <% if(data.status == 1) { %>
                                            <div class="mb-2 mr-2 badge badge-success">Active</div>
                                        <% } else { %>
                                            <div class="mb-2 mr-2 badge badge-secondary">Inactive</div>
                                        <% } %> 
                                    </td>
                                    <td>
                                        <a href="<%- siteUrl+'/'+pageUrl+'?action=view&id='+data.id %>" class="btn btn-focus btn-xs" data-toggle="tooltip" data-placement="top" title="View" data-original-title="View"><i class="fa fa-eye"></i></a>
                                        <a href="<%- siteUrl+'/'+pageUrl+'?action=edit&id='+data.id %>" class="btn btn-primary btn-xs" data-toggle="tooltip" data-placement="top" title="Edit" data-original-title="Edit"><i class="fas fa-edit"></i></a>
                                        <a href="javascript:del('<%- siteUrl+'/'+pageUrl+'?action=delete&id='+data.id %>')" class="btn btn-danger btn-xs deleteAction" data-toggle="tooltip" data-placement="top" title="Delete" data-original-title="Delete"><i class="fas fa-trash"></i></a>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>                        
                    </div>
                </div>
                <% } %>
			</div>
			<%- include('layouts/footer'); %>
		</div>
	</div>
</div>
<div class="app-drawer-overlay d-none animated fadeIn"></div>
<%- include('layouts/script'); %>
<script>
    $(document).ready(function() {
        $('#category').change(function() {
            var category = $(this).val();
             $.ajax({
                type : 'post',
                url :  'sub_service/get_categories',
                data : {
                    type: category,
                    subservice_id : $("#subservice_id").val()
                },
                success: function (response) {
                    var types = response;
                    console.log("types", types);
                    $('#showdata').empty();
                    $('#pricediv').show();
                    console.log(types,'types');
                    
                    $.each(types, function(index,item){
                        $('#showdata').append(`
                         <tr>
                            <td>
                                <input type="hidden" name="category_id" value="${item.id}"/>
                                <input type="text" class="form-control" name="duration" value="${item.title}"  readonly/>
                            </td>
                            <td>
                                <input type="text" class="form-control" name="price" placeholder="Enter price" value="${item?.subservice_prices?.[0]?.price || ''}"    />
                            </td>
                        </tr>
                        `);
                    })
                }
             })
        }).change().trigger()
    })
</script>
</body>
</html>
