<!DOCTYPE html>
<html lang="en">
<head>
	<%- include('layouts/meta'); %>
</head>
<body>
<div class="app-container app-theme-white body-tabs-shadow fixed-header fixed-sidebar">
	<%- include('layouts/header'); %>
	<div class="app-main">
		<%- include('layouts/sidebar'); %>
		<div class="app-main__outer">
			<div class="app-main__inner">
				<div class="app-page-title">
					<div class="page-title-wrapper">
						<div class="page-title-heading">
							<div><%- title %></div>
						</div>
						<div class="page-title-actions">
							<!-- <button type="button" data-toggle="tooltip" title="Example Tooltip" data-placement="bottom" class="btn-shadow mr-3 btn btn-dark">
								<i class="fa fa-star"></i>
							</button> -->
						</div>
					</div>
				</div>
                <% if(action=='add' || action=='edit') { %>
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-2"></div>
                            <div class="col-md-8">
                                <%- include('layouts/flash'); %>
                                <form action="/testimonial_post" method="post" name="testimonialForm" onsubmit="return textAreaRequired()" enctype="multipart/form-data">
                                    <input type="hidden" name="id" value="<%- row ? row.id : '' %>">
                                    <div class="form-group">
                                        <label class="label" for="name">Name *</label>
                                        <input type="text" class="form-control" id="name" name="name" value="<%- row ? row.name : '' %>" required/>
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="country">Country *</label>
                                        <select class="form-control" id="country" name="country"required>
                                            <option value="">Select</option>
                                            <% countries.forEach(function(country, index) { %>
                                            <option value="<%- country.name %>" <%- row && row.country == country.name ? 'selected' : '' %>><%- country.name %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="rating">Rating *</label>
                                        <select class="form-control" id="rating" name="rating"required>
                                            <option value="1" <%- row && row.rating == 1 ? 'selected' : '' %>>1</option>
                                            <option value="2" <%- row && row.rating == 2 ? 'selected' : '' %>>2</option>
                                            <option value="3" <%- row && row.rating == 3 ? 'selected' : '' %>>3</option>
                                            <option value="4" <%- row && row.rating == 4 ? 'selected' : '' %>>4</option>
                                            <option value="5" <%- row && row.rating == 5 ? 'selected' : '' %>>5</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="description">Description *</label>
                                        
                                        <textarea name="description" id="description" rows="5" class="form-control joeditor"><%- row ? row.description : "" %></textarea>
                                    </div>

                                    <div class="form-group">
                                        <label class="label" for="photo">Image *</label>
                                        <% if(row && row.photo) { %>
                                        <input type="file" class="form-control" id="photo" name="photo" value="<%- row ? row.photo : '' %>"/>
                                        <% } else{ %>
                                            <input type="file" class="form-control" id="photo" name="photo" value="<%- row ? row.photo : '' %>" required/>
                                        <% } %>
                                        <input type="hidden" id="photo_old" name="photo_old" value="<%- row ? row.photo : '' %>"/>
                                        <span class="help-block text-danger"><b>Recommend Size : 127 X 107 PX.</b></span><br>
                                        <% if(row && row.photo) { %>
                                            <a href="<%- siteUrl +'/uploads/testimonials/'+ row.photo %>" target="_blank">
                                                <img class="img-thumbnail" src="<%- siteUrl +'/uploads/testimonials/'+ row.photo %>" style="max-height: 80px;"/>
                                            </a>
                                        <% } %>
                                    </div>

                                    <div class="form-group">
                                        <label class="label" for="altTag">Alt Tag</label>
                                        <input type="text" class="form-control" id="altTag" name="altTag" value="<%- row ? row.altTag : '' %>"/>
                                    </div>
                                    <div class="form-group">
                                        <label class="label" for="status">Status *</label>
                                        <select class="form-control" id="status" name="status"required>
                                            <option value="1" <%- row && row.status == 1 ? 'selected' : '' %>>Active</option>
                                            <option value="0" <%- row && row.status == 0 ? 'selected' : '' %>>Inactive</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <a href="<%- siteUrl +'/'+ page %>" class="btn btn-secondary" style="color: white;">Cancel</a>
                                        <button type="submit" class="btn btn-primary">Submit</button>
                                    </div>
                                </form>
                            </div>
                            <div class="col-md-2"></div>
                        </div>
                    </div>
                </div>    
                <% } else if(action=='view') { %>
                    <!-- id, name, country, rating, description, photo, status, publishedAt -->
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <table class="mb-0 table table-bordered">
                            <tbody>
                                <tr>
                                    <th style="width: 15%">Title</th>
                                    <td><%- row.name %></td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Country</th>
                                    <td><%- row.country %></td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Rating</th>
                                    <td><%- row.rating %></td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Description</th>
                                    <td><%- row.description %></td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Image</th>
                                    <td>
                                        <a href="<%- siteUrl +'/uploads/testimonials/'+ row.photo %>" target="_blank">
                                            <img class="img-thumbnail" src="<%- siteUrl +'/uploads/testimonials/'+ row.photo %>" style="max-height: 100px;"/>
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <th style="width: 15%">Alt Tag</th>
                                    <td><%- row.altTag %></td>
                                </tr>
                                <!-- <tr>
                                    <th style="width: 15%">Updated At</th>
                                    <td><%- new Date(row.updatedAt).toLocaleString('en-GB', { hour12: false }) %></td>
                                </tr> -->
                                <tr>
                                    <th style="width: 15%">Status</th>
                                    <td>
                                        <% if(row.status == 1) { %>
                                            <div class="mb-2 mr-2 badge badge-success">Active</div>
                                        <% } else { %>
                                            <div class="mb-2 mr-2 badge badge-secondary">Inactive</div>
                                        <% } %>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <br>
                        <a href="<%- siteUrl+'/'+pageUrl %>" class="btn btn-secondary btn-icon" style="color: white;"><i class="pe-7s-back btn-icon-wrapper"> </i>Back</a>
                    </div>
                </div>
                <% } else { %>
                <div class="row">
                    <div class="col-md-12">
                        <%- include('layouts/flash'); %>
                        <a href="<%- siteUrl +'/'+ page %>?action=add" class="mb-2 mr-2 btn-icon btn btn-primary pull-right"><i class="fa fa-plus"></i> Add New Record</a>
                    </div>
                </div>
                <div class="main-card mb-3 card">
                    <div class="card-body">
                        <table style="width: 100%;" id="example" class="table table-hover table-striped table-bordered">
                            <thead>
                                <tr>
                                    <!-- id, name, country, rating, description, photo, status, publishedAt -->
                                    <th width="5%">#</th>
                                    <th>Name</th>
                                    <th>Country</th>
                                    <th>Rating</th>
                                    <th>Description</th>
                                    <th>Photo</th>
                                    <th width="5%">Status</th>
                                    <th width="15%" style="text-align: center;vertical-align: middle;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% rows.forEach(function(data, index) { %>
                                <tr>
                                    <td><%- index + 1 %></td>
                                    <td><%- data.name %></td>
                                    <td><%- data.country %></td>
                                    <td><%- data.rating %></td>
                                    <td><%- data.description %></td>
                                    <td>
                                        <% if(data.photo) { %>
                                            <a href="<%- siteUrl +'/uploads/testimonials/'+ data.photo %>" target="_blank">
                                                <img class="img-thumbnail" src="<%- siteUrl +'/uploads/testimonials/'+ data.photo %>" style="max-height: 50px;"/>
                                            </a>
                                        <% } %>
                                    </td>
                                    <!-- <td><%- data.altTag %></td> -->
                                    <!-- <td><%- new Date(data.updatedAt).toLocaleString('en-GB', { hour12: false }) %></td> -->
                                    <td>
                                        <% if(data.status == 1) { %>
                                            <div class="mb-2 mr-2 badge badge-success">Active</div>
                                        <% } else { %>
                                            <div class="mb-2 mr-2 badge badge-secondary">Inactive</div>
                                        <% } %>
                                    </td>
                                    <td style="text-align: center;vertical-align: middle;">
                                        <!-- <a href="<%- siteUrl+'/'+pageUrl+'?action=view&id='+data.id %>" class="btn btn-focus btn-xs" data-toggle="tooltip" data-placement="top" title="View" data-original-title="View"><i class="fa fa-eye"></i></a> -->
                                        <!-- <a href="<%- siteUrl+'/'+pageUrl+'?action=edit&id='+data.id %>" class="btn btn-primary btn-xs" data-toggle="tooltip" data-placement="top" title="Edit" data-original-title="Edit"><i class="fas fa-edit"></i></a> -->
                                        <!-- <a href="javascript:del('<%- siteUrl+'/'+pageUrl+'?action=delete&id='+data.id %>')" class="btn btn-danger btn-xs" data-toggle="tooltip" data-placement="top" title="Delete" data-original-title="Delete"><i class="fas fa-trash"></i></a> -->
                                        <a href="<%- siteUrl+'/'+pageUrl+'?action=view&id='+data.id %>" class="btn "  data-toggle="tooltip" data-placement="top" title="View" data-original-title="View"><span style=" color: rgb(0, 0, 0);"><i class="fa fa-eye" title="View"></i></span></a>
                                        <a href="<%- siteUrl+'/'+pageUrl+'?action=edit&id='+data.id %>" class="btn "  data-toggle="tooltip" data-placement="top" title="Edit" data-original-title="Edit"><span style=" color: rgb(32, 108, 221);"><i class="fa fa-pen" title="Edit"></i></span></a>
                                        <a href="javascript:del('<%- siteUrl+'/'+pageUrl+'?action=delete&id='+data.id %>')" class="btn" data-toggle="tooltip" data-placement="top" title="Delete" data-original-title="Delete"><span style=" color: red;"><i class="fa fa-trash" title="Delete"></i></span></a>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>                        
                    </div>
                </div>
                <% } %>
			</div>
			<%- include('layouts/footer'); %>
		</div>
	</div>
</div>
<div class="app-drawer-overlay d-none animated fadeIn"></div>
<%- include('layouts/script'); %>
<script>
function appendRow(gethisii) 
{ 
    var tblBody = document.getElementById(gethisii).tBodies[0];
    var newNode = tblBody.rows[0].cloneNode(true);
    tblBody.appendChild(newNode);
}
</script>
<script>
function textAreaRequired() {
  var empt = document.forms["testimonialForm"]["description"].value;
  if (empt == "") {
    alert("Please fill the description");
    return false;
  } else {
    return true;
  }
}
</script>
<script type="text/javascript">
var deleteRow = function (link, getthis) 
{
    var rowCount = $('#'+getthis+' >tbody >tr').length;
    if(rowCount > 1)  
    {
        var row = link.parentNode.parentNode;
        var table = row.parentNode; 
        table.removeChild(row);
    } 
}
</script>
</body>
</html>