  <link rel="icon" href="<%= faviconUrl %>">
  <link href="<%= siteUrl %>/main.d810cf0ae7f39f28f336.css" rel="stylesheet">
  <style>
    .app-header__logo .logo-src {
      height: 35px;
      width: 150px;
      background: url('<%= headerLogoUrl %>');
      background-size: contain;
      background-repeat: no-repeat;
      background-position: left center;
    }

    .form-group .label {
      font-weight: bold;
    }

    .img-thumbnail {
