<title>
  <%= metaTitle %>
</title>
<% let currentFavicon='1786104589569-Favicon.ico' ; if (typeof favicon !=='undefined' && favicon) {
  currentFavicon=favicon; } else if (typeof settings !=='undefined' && settings && settings.favicon) {
  currentFavicon=settings.favicon; } else if (typeof data !=='undefined' && data && data.favicon) {
  currentFavicon=data.favicon; } let faviconUrl=(currentFavicon.startsWith('http://') ||
