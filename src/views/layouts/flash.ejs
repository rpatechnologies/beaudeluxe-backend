<script type="text/javascript">setTimeout("document.getElementById('flash-success-or-failure-box').style.display='none';", 3000); </script>

<% if(success && success.length) {%>
<div id="flash-success-or-failure-box" class="alert alert-success alert-dismissible">
    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
    <%= success %>
</div>
<% } %>
 
<% if(error && error.length) {%>
<div id="flash-success-or-failure-box" class="alert alert-danger alert-dismissible">
    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
    <%= error %>
</div>
<% } %>
