<script>
if (document.querySelector('.joeditor') != undefined) {
    var editors = [].slice.call(document.querySelectorAll('.joeditor'));
    editors.forEach(function (div) {
        if (!Jodit.instances[div.id]) {
            var editor = new Jodit(div, {
                preset: '',
                language: 'en',
                toolbarButtonSize: "middle",
                removeButtons: ['superscript', 'subscript'],
                showTooltip: true
            });
        }
    });
}
</script>

