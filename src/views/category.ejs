<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('layouts/meta'); %>
</head>

<body>
    <div class="app-container app-theme-white body-tabs-shadow fixed-header fixed-sidebar">
        <%- include('layouts/header'); %>
            <div class="app-main">
                <%- include('layouts/sidebar'); %>
                    <div class="app-main__outer">
                        <div class="app-main__inner">
                            <div class="app-page-title">
                                <div class="page-title-wrapper">
                                    <div class="page-title-heading">
                                        <div><%- title %></div>
                                    </div>
                                    <div class="page-title-actions">
                                        <!-- <button type="button" data-toggle="tooltip" title="Example Tooltip" data-placement="bottom" class="btn-shadow mr-3 btn btn-dark">
								<i class="fa fa-star"></i>
							</button> -->
                                    </div>
                                </div>
                            </div>
                            <% if(action=='add' || action=='edit' ) { %>
                                <div class="main-card mb-3 card">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-2"></div>
                                            <div class="col-md-8">
                                                <%- include('layouts/flash'); %>
                                                    <form action="/category_post" method="post"
                                                        enctype="multipart/form-data">
                                                        <input type="hidden" name="id" value="<%- row ? row.id : '' %>">
                                                        <div class="form-group">
                                                            <label class="label" for="type">Select Type *</label>
                                                            <select class="form-control" id="type" name="type" required>
                                                                <option value="">Select</option>
                                                                <option value="category">Category</option>
                                                                <option value="gender">Gender</option>
                                                                <option value="duration">Duration</option>
                                                            </select>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="label" for="title">Title *</label>
                                                            <input type="text" class="form-control" id="title"
                                                                name="title" value="<%- row ? row.title : '' %>"
                                                                required />
                                                        </div>
                                                        <div class="form-group">
                                                            <a href="<%- siteUrl+'/'+pageUrl %>"
                                                                class="btn btn-secondary"
                                                                style="color: white;">Cancel</a>
                                                            <button type="submit"
                                                                class="btn btn-primary">Submit</button>
                                                        </div>
                                                    </form>
                                            </div>
                                            <div class="col-md-2"></div>
                                        </div>
                                    </div>
                                </div>
                                <% } else if(action=='view' ) { %>
                                    <div class="main-card mb-3 card">
                                        <div class="card-body">
                                            <table class="mb-0 table table-bordered">
                                                <tbody>
                                                    <tr>
                                                        <th style="width: 15%">Title</th>
                                                        <td><%- row.title %></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <br>
                                            <a href="<%- siteUrl+'/'+pageUrl %>" class="btn btn-secondary btn-icon"
                                                style="color: white;"><i class="pe-7s-back btn-icon-wrapper">
                                                </i>Back</a>
                                        </div>
                                    </div>
                                    <% } else { %>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <%- include('layouts/flash'); %>
                                                    <a href="<%- siteUrl+'/'+pageUrl+'?action=add' %>"
                                                        class="mb-2 mr-2 btn-icon btn btn-primary pull-right"><i
                                                            class="fa fa-plus"></i> Add New Record</a>
                                            </div>
                                        </div>
                                        <div class="main-card mb-3 card">
                                            <div class="card-body">
                                                <table style="width: 100%;" id="example"
                                                    class="table table-hover table-striped table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th width="5%">#</th>
                                                            <!-- <th>Page</th> -->
                                                            <th>Title</th>
                                                            <th width="15%"
                                                                style="text-align: center;vertical-align: middle;">
                                                                Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% rows.forEach(function(data, index) { %>
                                                            <tr>
                                                                <td><%- index + 1 %></td>
                                                                <!-- <td><%- data.page_id ? data.page_id : '' %></td> -->
                                                                <td><%- data.title %></td>
                                                                <td style="text-align: center;vertical-align: middle;">
                                                                    <!-- <a href="<%- siteUrl+'/'+pageUrl+'?action=view&id='+data.id %>" class="btn btn-focus btn-xs" data-toggle="tooltip" data-placement="top" title="View" data-original-title="View"><i class="fa fa-eye"></i></a> -->
                                                                    <!-- <a href="<%- siteUrl+'/'+pageUrl+'?action=edit&id='+data.id %>" class="btn btn-primary btn-xs" data-toggle="tooltip" data-placement="top" title="Edit" data-original-title="Edit"><i class="fas fa-edit"></i></a> -->
                                                                    <!-- <a href="javascript:del('<%- siteUrl+'/'+pageUrl+'?action=delete&id='+data.id %>')" class="btn btn-danger btn-xs" data-toggle="tooltip" data-placement="top" title="Delete" data-original-title="Delete"><i class="fas fa-trash"></i></a> -->
                                                                    <a href="<%- siteUrl+'/'+pageUrl+'?action=view&id='+data.id %>"
                                                                        class="btn " data-toggle="tooltip"
                                                                        data-placement="top" title="View"
                                                                        data-original-title="View"><span
                                                                            style=" color: rgb(0, 0, 0);"><i
                                                                                class="fa fa-eye"
                                                                                title="View"></i></span></a>
                                                                    <a href="<%- siteUrl+'/'+pageUrl+'?action=edit&id='+data.id %>"
                                                                        class="btn " data-toggle="tooltip"
                                                                        data-placement="top" title="Edit"
                                                                        data-original-title="Edit"><span
                                                                            style=" color: rgb(32, 108, 221);"><i
                                                                                class="fa fa-pen"
                                                                                title="Edit"></i></span></a>
                                                                    <a href="javascript:del('<%- siteUrl+'/'+pageUrl+'?action=delete&id='+data.id %>')"
                                                                        class="btn" data-toggle="tooltip"
                                                                        data-placement="top" title="Delete"
                                                                        data-original-title="Delete"><span
                                                                            style=" color: red;"><i class="fa fa-trash"
                                                                                title="Delete"></i></span></a>
                                                                </td>
                                                            </tr>
                                                            <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <% } %>
                        </div>
                        <%- include('layouts/footer'); %>
                    </div>
            </div>
    </div>
    <div class="app-drawer-overlay d-none animated fadeIn"></div>
    <%- include('layouts/script'); %>
</body>

</html>