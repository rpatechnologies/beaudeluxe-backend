<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('layouts/meta'); %>
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
</head>

<body>
    <div class="app-container app-theme-white body-tabs-shadow fixed-header fixed-sidebar">
        <%- include('layouts/header'); %>
            <div class="app-main">
                <%- include('layouts/sidebar'); %>
                    <div class="app-main__outer">
                        <div class="app-main__inner">
                            <div class="app-page-title">
                                <div class="page-title-wrapper">
                                    <div class="page-title-heading">
                                        <div><%- title %></div>
                                    </div>
                                    <div class="page-title-actions">
                                        <!-- <button type="button" data-toggle="tooltip" title="Example Tooltip" data-placement="bottom" class="btn-shadow mr-3 btn btn-dark">
								<i class="fa fa-star"></i>
							</button> -->
                                    </div>
                                </div>
                            </div>
                            <% if(action=='add' || action=='edit' ) { %>
                                <div class="main-card mb-3 card">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-2"></div>
                                            <div class="col-md-8">
                                                <%- include('layouts/flash'); %>

                                                    <form action="/service_post" method="post" name="serviceForm"
                                                        onsubmit="return textAreaRequired()"
                                                        enctype="multipart/form-data">
                                                        <input type="hidden" name="id" value="<%- row ? row.id : '' %>">
                                                        <div class="form-group">
                                                            <label class="label" for="title">Title *</label>
                                                            <input type="text" class="form-control" id="title"
                                                                name="title" value="<%- row ? row.title : '' %>"
                                                                required />
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="label" for="service_title">Service Title</label>
                                                            <input type="text" class="form-control" id="service_title"
                                                                name="service_title" value="<%- row ? (row.service_title || '') : '' %>"
                                                                placeholder="e.g. Hair Studio or Nail Care & Art" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="label" for="text_color">Text Color</label>
                                                            <div class="input-group">
                                                                <input type="color" class="form-control col-md-2" id="text_color_picker"
                                                                    value="<%- row && row.text_color ? row.text_color : '#ffffff' %>"
                                                                    style="height: 38px; padding: 2px 6px; cursor: pointer;"
                                                                    onchange="document.getElementById('text_color').value = this.value">
                                                                <input type="text" class="form-control" id="text_color"
                                                                    name="text_color" value="<%- row ? (row.text_color || '') : '' %>"
                                                                    placeholder="e.g. #ffffff or #000000"
                                                                    onchange="document.getElementById('text_color_picker').value = this.value" />
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="label" for="description">Description *</label>
                                                            <textarea class="form-control joeditor" id="description"
                                                                name="description"
                                                                required><%- row ? row.description : '' %></textarea>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="label" for="order_number">Order Number
                                                                *</label>
                                                            <input type="text" class="form-control" id="order_number"
                                                                name="order_number"
                                                                value="<%- row ? row.order_number : '' %>" required />
                                                        </div>
                                                        <!-- <div class="form-group">
                                        <label class="label" for="short_description">Short Description *</label>
                                        <textarea class="form-control" id="short_description" name="short_description" required><%- row.short_description %></textarea>
                                    </div> -->
                                                        <!-- <div class="form-group">
                                        <label class="label" for="heading">Shadow Title *</label>
                                        <input type="text" class="form-control" id="heading" name="heading" value="<%- row ? row.heading : '' %>" required/>
                                    </div> -->
                                                        <!-- <div class="form-group">
                                        <label class="label" for="description">Description *</label>
                                        <textarea class="form-control joeditor" id="description" name="description"><%- row ? row.description : '' %></textarea>
                                    </div> -->
                                                        <div class="form-group">
                                                            <label class="label" for="image">Image *</label>
                                                            <input type="file" class="form-control" id="image"
                                                                name="image" <%- row && row.image ? '' : 'required' %>/>
                                                            <input type="hidden" id="image_old" name="image_old"
                                                                value="<%- row ? row.image : '' %>" />
                                                            <span class="help-block text-danger"><b>Recommend Size : 463
                                                                    X 441 PX.</b></span><br>
                                                            <% if(row && row.image) { %>
                                                                <a href="<%- siteUrl +'/uploads/service/'+ row.image %>"
                                                                    target="_blank">
                                                                    <img class="img-thumbnail"
                                                                        src="<%- siteUrl +'/uploads/service/'+ row.image %>" />
                                                                </a>
                                                                <% } %>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="label" for="altTag">Alt Tag</label>
                                                            <input type="text" class="form-control" id="altTag"
                                                                name="altTag" value="<%- row ? row.altTag : '' %>" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="label" for="logo">Logo *</label>
                                                            <input type="file" class="form-control" id="logo"
                                                                name="logo" <%- row && row.logo ? '' : 'required' %>/>
                                                            <input type="hidden" id="logo_old" name="logo_old"
                                                                value="<%- row ? row.logo : '' %>" />
                                                            <span class="help-block text-danger"><b>Recommend Size : 446
                                                                    X 446 PX.</b></span><br>
                                                            <% if(row && row.logo) { %>
                                                                <a href="<%- siteUrl +'/uploads/service/'+ row.logo %>"
                                                                    target="_blank">
                                                                    <img class="img-thumbnail"
                                                                        src="<%- siteUrl +'/uploads/service/'+ row.logo %>" />
                                                                </a>
                                                                <% } %>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="label" for="altTagLogo">Alt Tag Logo</label>
                                                            <input type="text" class="form-control" id="altTagLogo"
                                                                name="altTagLogo"
                                                                value="<%- row ? row.altTagLogo : '' %>" />
                                                        </div>
                                                        <div class="card mb-3">
                                                            <div class="card-header">Service Card Details</div>
                                                            <div class="card-body">
                                                                <div class="form-group">
                                                                    <label class="label" for="card_tag">Card Tag /
                                                                        Category Title</label>
                                                                    <input type="text" class="form-control"
                                                                        id="card_tag" name="card_tag"
                                                                        value="<%- row ? (row.card_tag || '') : '' %>"
                                                                        placeholder="e.g. RELAXATION THERAPY" />
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="label" for="card_title">Card
                                                                        Title</label>
                                                                    <input type="text" class="form-control"
                                                                        id="card_title" name="card_title"
                                                                        value="<%- row ? (row.card_title || '') : '' %>"
                                                                        placeholder="e.g. RELAXATION THERAPY" />
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="label" for="card_description">Card
                                                                        Quote / Description</label>
                                                                    <textarea class="form-control joeditor"
                                                                        id="card_description" name="card_description"
                                                                        rows="3"><%- row ? (row.card_description || '') : '' %></textarea>
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="label" for="card_image">Card
                                                                        Image</label>
                                                                    <input type="file" class="form-control"
                                                                        id="card_image" name="card_image" />
                                                                    <input type="hidden" id="card_image_old"
                                                                        name="card_image_old"
                                                                        value="<%- row ? (row.card_image || '') : '' %>" />
                                                                    <% if(row && row.card_image) { %>
                                                                        <br>
                                                                        <a href="<%- siteUrl +'/uploads/service/'+ row.card_image %>"
                                                                            target="_blank">
                                                                            <img class="img-thumbnail"
                                                                                style="max-height: 120px;"
                                                                                src="<%- siteUrl +'/uploads/service/'+ row.card_image %>" />
                                                                        </a>
                                                                        <% } %>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <!-- <div class="form-group">
                                        <label class="label" for="details_heading">Details Heading *</label>
                                        <input type="text" class="form-control" id="details_heading" name="details_heading" value="<%- row ? row.details_heading : '' %>" required/>
                                    </div> -->
