                                                        <td><%- row.title %></td>
                                                    </tr>
                                                    <tr>
                                                        <th style="width: 15%">Order Number</th>
                                                        <td><%- row.order_number %></td>
                                                    </tr>
                                                    <tr>
                                                        <th style="width: 15%">Image</th>
                                                        <td>
                                                            <a href="<%- siteUrl +'/uploads/service/'+ row.image %>"
                                                                target="_blank">
                                                                <img class="img-thumbnail"
                                                                    src="<%- siteUrl +'/uploads/service/'+ row.image %>" />
                                                            </a>
                                                        </td>
                                                    </tr>
                                                    <!-- altTag -->
                                                    <tr>
                                                        <th style="width: 15%">Alt Tag</th>
                                                        <td><%- row.altTag %></td>
                                                    </tr>
                                                    <tr>
                                                        <th style="width: 15%">Banner</th>
                                                        <td>
                                                            <a href="<%- siteUrl +'/uploads/service/banners/'+ row.banner %>"
                                                                target="_blank">
                                                                <img class="img-thumbnail"
                                                                    src="<%- siteUrl +'/uploads/service/banners/'+ row.banner %>" />
                                                            </a>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th style="width: 15%">Banner Alt Tag</th>
                                                        <td><%- row.altTagBanner %></td>
                                                    </tr>

                                                    <tr>
                                                        <th style="width: 15%">Meta Title</th>
                                                        <td><%- row.meta_title %></td>
                                                    </tr>
                                                    <tr>
                                                        <th style="width: 15%">Meta Description</th>
                                                        <td><%- row.meta_description %></td>
                                                    </tr>
                                                    <tr>
                                                        <th style="width: 15%">Meta Keywords</th>
                                                        <td><%- row.meta_keywords %></td>
                                                    </tr>
                                                    <tr>
                                                        <th style="width: 15%">Show In Menu</th>
                                                        <td>
                                                            <% if(row.show_in_menu==1) { %>
                                                                <img style="height: 20px;width: 20px;"
                                                                    src="<%- siteUrl +'/img/success.png' %>" />
                                                                <% } else { %>
                                                                    <img style="height: 20px;width: 20px;"
                                                                        src="<%- siteUrl +'/img/cross.png' %>" />
                                                                    <% } %>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th style="width: 15%">Show On Homepage</th>
                                                        <td>
                                                            <% if(row.show_on_home==1) { %>
                                                                <img style="height: 20px;width: 20px;"
                                                                    src="<%- siteUrl +'/img/success.png' %>" />
                                                                <% } else { %>
                                                                    <img style="height: 20px;width: 20px;"
                                                                        src="<%- siteUrl +'/img/cross.png' %>" />
                                                                    <% } %>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th style="width: 15%">Updated At</th>
                                                        <td><%- new Date(row.updatedAt).toLocaleString('en-GB', {
                                                                hour12: false }) %></td>
                                                    </tr>
                                                    <tr>
                                                        <th style="width: 15%">Status</th>
                                                        <td>
                                                            <% if(row.status==1) { %>
                                                                <div class="mb-2 mr-2 badge badge-success">Active</div>
                                                                <% } else { %>
                                                                    <div class="mb-2 mr-2 badge badge-secondary">
                                                                        Inactive</div>
                                                                    <% } %>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <br>
                                            <a href="<%- siteUrl+'/'+pageUrl %>" class="btn btn-secondary btn-icon"
                                                style="color: white;"><i class="pe-7s-back btn-icon-wrapper">
                                                </i>Back</a>
                                        </div>
                                    </div>
                                    <% } else { %>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <%- include('layouts/flash'); %>
                                                    <a href="<%- siteUrl +'/'+ page %>?action=add"
                                                        class="mb-2 mr-2 btn-icon btn btn-primary pull-right"><i
                                                            class="fa fa-plus"></i> Add New Record</a>
                                            </div>
                                        </div>
                                        <div class="main-card mb-3 card">
                                            <div class="card-body">
                                                <table style="width: 100%;" id="example"
                                                    class="table table-hover table-striped table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th width="5%">#</th>
                                                            <th>Title</th>
                                                            <!-- <th>Short Description</th> -->
                                                            <!-- <th>Heading</th> -->
                                                            <th>Image</th>
                                                            <!-- <th>Alt Tag</th> -->
                                                            <th>Show In Menu</th>
                                                            <!-- <th>Alt Tag Show In Menu</th> -->
                                                            <th>Show On Homepage</th>
                                                            <th>Slug</th>
                                                            <!-- <th width="10%">Updated At</th> -->
                                                            <th width="5%">Status</th>
                                                            <th width="15%"
                                                                style="text-align: center;vertical-align: middle;">
                                                                Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% rows.forEach(function(data, index) { %>
                                                            <tr>
                                                                <td><%- index + 1 %></td>
